# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------- FIREBASE CLIENT-SIDE CONFIGURATION ----------------
# Overrides default firebase-applet-config.json when provided in client environment
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# ---------------- BANGLADESH PAYMENT GATEWAYS & MFS (PHASE 16) ----------------

# Global Payment & Webhook Verification Secret
PAYMENT_PROVIDER_KEYS=
PAYMENT_WEBHOOK_SECRET=

# bKash Direct Merchant Credentials (PGW v1.2.0-ECOM)
BKASH_CLIENT_ID=
BKASH_CLIENT_SECRET=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_MERCHANT_NUMBER=
BKASH_SANDBOX=true

# SSLCommerz Bangladesh Card/Bank Payment Gateway
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_ENVIRONMENT=sandbox
SSLCOMMERZ_SANDBOX=true

# Nagad Online Direct Credentials
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_SANDBOX=true

# DBBL Rocket Gateway Credentials
ROCKET_MERCHANT_ID=
ROCKET_API_KEY=
ROCKET_SANDBOX=true

# Upay (UCB Fintech MFS) Gateway Credentials
UPAY_MERCHANT_ID=
UPAY_API_KEY=
UPAY_SANDBOX=true
UPAY_DISABLED=false

# ---------------- BANGLADESH COURIER & LOGISTICS GATEWAYS (PHASE 16) ----------------

# Pathao Courier API v2 Credentials
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_ACCESS_TOKEN=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_SANDBOX=true

# Steadfast Courier Merchant API Credentials
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1

# RedX Bangladesh Delivery API Credentials
REDX_API_TOKEN=
REDX_SANDBOX=true

# Paperfly Go-Fly Express API Credentials
PAPERFLY_USERNAME=
PAPERFLY_PASSWORD=
PAPERFLY_KEY=

# eCourier API Credentials
ECOURIER_USER_ID=
ECOURIER_API_KEY=
ECOURIER_API_SECRET=

# Global Courier Webhook Secret
COURIER_WEBHOOK_SECRET=

# ---------------- TRANSACTIONAL NOTIFICATION GATEWAYS (PHASE 16 & 19) ----------------
# Real Email Gateway (Resend, SendGrid, or Custom SMTP)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=orders@sunno.app
EMAIL_SERVICE_PROVIDER=resend
EMAIL_ENABLED=true
EMAIL_MODE=sandbox # disabled | sandbox | live

# Bangladesh Direct SMS Gateway (Greenweb, SSL Wireless, or Twilio)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_URL=https://api.greenweb.com.bd/api.php
SMS_PROVIDER_SENDER_ID=SUNNO
SMS_SENDER_ID=SUNNO
SMS_SERVICE_PROVIDER=greenweb
SMS_ENABLED=true
SMS_MODE=sandbox # disabled | sandbox | live

# ---------------- SELLER PAYOUT & DISBURSEMENT GATEWAYS (PHASE 18) ----------------
# Global payout mode: disabled | sandbox | live
PAYOUT_MODE=sandbox
EARNINGS_RELEASE_DAYS=7
MIN_WITHDRAWAL_BDT=500

# bKash B2C Direct Disbursement API Credentials
BKASH_PAYOUT_APP_KEY=
BKASH_PAYOUT_APP_SECRET=
BKASH_PAYOUT_USERNAME=
BKASH_PAYOUT_PASSWORD=
BKASH_PAYOUT_SANDBOX=true

# Nagad Corporate Disbursement API Credentials
NAGAD_DISBURSEMENT_MERCHANT_ID=
NAGAD_DISBURSEMENT_PUBLIC_KEY=
NAGAD_DISBURSEMENT_PRIVATE_KEY=
NAGAD_PAYOUT_SANDBOX=true

# DBBL Rocket Corporate Payout API Credentials
ROCKET_CORPORATE_MERCHANT_ID=
ROCKET_CORPORATE_PIN=
ROCKET_PAYOUT_SANDBOX=true

# Bank Electronic Fund Transfer (BEFTN/NPSB) Payout Credentials
BANK_PAYOUT_CLIENT_ID=
BANK_PAYOUT_SECRET=
BANK_PAYOUT_SANDBOX=true


